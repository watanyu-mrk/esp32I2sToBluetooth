# Target: ESP32-WROVER (ESP32-D0WD, 4 MB flash + 8 MB PSRAM)
CONFIG_IDF_TARGET="esp32"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# PSRAM: the decoded PCM jitter buffer, the MP3 decode scratch buffers and the
# mbedTLS socket buffers all live there, leaving internal RAM to Bluetooth.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
# 40 MHz keeps PSRAM in step with the 40 MHz flash clock above (IDF falls back
# to 40 MHz for 80 MHz PSRAM when flash runs slower, so ask for it directly).
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Bluetooth Classic + A2DP source only (no BLE): frees RAM for the audio path
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=4352

# Wi-Fi streams the radio station, so it has to stay in flash (not IRAM):
# keeping Bluetooth inside IRAM is what makes this fit.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# One station socket plus one config page, and the TCP window has to survive
# the Wi-Fi/Bluetooth coexistence gaps without stalling the stream.
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760

# HTTPS stations: the certificate bundle is pulled from flash, nothing is
# verified against a pinned key.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Bluetooth stack + A2DP library + HTTP/TLS + MP3 decoder do not fit in the
# default 1 MB factory partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
